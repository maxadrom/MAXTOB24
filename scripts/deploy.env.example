# =============================================================================
# Координаты боевого VPS для scripts/deploy.sh (M12.8)
# =============================================================================
# Это ШАБЛОН (плейсхолдеры вместо значений) — он КОММИТИТСЯ (.gitignore whitelist).
# Реальные координаты — в scripts/deploy.env (под .gitignore, НЕ коммитится).
#
# Быстрый старт:
#   cp scripts/deploy.env.example scripts/deploy.env   # затем заполнить реальными значениями
#
# Файл подключается через `source` в scripts/deploy.sh — это shell-присваивания.
# СЕКРЕТЫ СЮДА НЕ КЛАСТЬ: только координаты/пути. Боевые секреты живут в ENV_PROD.

# SSH-пользователь на VPS.
VPS_USER=__VPS_USER__

# Хост VPS (домен или IP).
VPS_HOST=__VPS_HOST__

# Путь к проекту на VPS (с завершающим слешем).
VPS_PATH=/home/__VPS_USER__/projects/__PROJECT__/

# Путь к ЛОКАЛЬНОМУ боевому .env (реальные секреты, под .gitignore).
# Используется `make pull-prod-env` (бэкап-затягивание с VPS). На VPS НЕ заливается.
ENV_PROD=./.env.prod

# Адрес health-проверки НА ХОСТЕ VPS (loopback-порт api-node).
# Проверяется через SSH-обёртку: ssh VPS 'curl -fsS http://$REMOTE_HEALTH_URL'.
REMOTE_HEALTH_URL=127.0.0.1:5182/health
