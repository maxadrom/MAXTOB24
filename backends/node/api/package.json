{
  "name": "maxtob24",
  "version": "1.0.0",
  "description": "Коннектор групповых чатов MAX к Открытым линиям Битрикс24",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/maxadrom/MAXTOB24.git",
    "directory": "backends/node/api"
  },
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "test": "vitest run --no-file-parallelism",
    "test:watch": "vitest --no-file-parallelism",
    "db:migrate": "node src/shared/db/runMigrations.js",
    "register-connector": "node scripts/register-connector.js",
    "register-webhook": "node scripts/register-webhook.js",
    "register-events": "node scripts/register-events.js",
    "audit-bindings": "node scripts/audit-bindings.js",
    "probe-imconnector-send": "node scripts/probe-imconnector-send.js",
    "probe-max-send": "node scripts/probe-max-send.js",
    "probe-max-upload": "node scripts/probe-max-upload.js",
    "probe-media-memory": "node scripts/probe-media-memory.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "pg": "^8.21.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.10",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "vitest": "^4.1.7"
  },
  "pnpm": {
    "overrides": {
      "path-to-regexp": ">=8.4.0",
      "qs": ">=6.15.2"
    }
  }
}
