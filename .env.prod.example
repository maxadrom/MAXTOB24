# =============================================================================
# PROD-окружение MAX↔Б24 на VPS (single-tenant, домен __PROD_DOMAIN__)
# =============================================================================
# Это ШАБЛОН (плейсхолдеры вместо секретов) — он коммитится (.gitignore whitelist).
# Боевой .env с реальными секретами живёт ТОЛЬКО на VPS (<VPS_PATH>/.env, под .gitignore).
# Деплой кода (make deploy) этот файл на VPS НЕ заливает; снять резервную копию на локаль
# (./.env.prod) — `make pull-prod-env`. Координаты VPS — в scripts/deploy.env.
#
# Роутинг по путям на проде делает общий Caddy (site-блок __PROD_DOMAIN__).
# См. docs/deploy/vps-prod.md.

## --- Режим/сборка/логи -------------------------------------------------------
NODE_ENV=production
BUILD_TARGET=production
LOG_LEVEL=info

## --- MAX Bot API -------------------------------------------------------------
MAX_BOT_TOKEN=__PROD_MAX_BOT_TOKEN__
MAX_WEBHOOK_SECRET=__PROD_MAX_WEBHOOK_SECRET__
# Канонический хост MAX API; сертификат выдан Russian Trusted Sub CA (Минцифры) — в образе
# корень подключён через NODE_EXTRA_CA_CERTS (Dockerfile). Вне Docker без CA — https://botapi.max.ru.
MAX_API_BASE_URL=https://platform-api2.max.ru
# Боевой webhook-URL: Caddy терминирует TLS и проксирует на loopback-порт api-node (5182).
# Используется register-webhook.js.
MAX_PUBLIC_WEBHOOK_URL=https://__PROD_DOMAIN__/webhook/max

## --- Bitrix24 ----------------------------------------------------------------
B24_PORTAL=__PROD_PORTAL__
# КРИТИЧНО для prod: без CLIENT_ID/SECRET install-callback (/api/install) отвечает 503,
# а B24Client не сделает auto-refresh access_token — inbound «замолчит» через ~1 ч.
# Обязательны в боевом .env (порядок первой установки — docs/backend/app-installation.md).
B24_CLIENT_ID=__PROD_B24_CLIENT_ID__
B24_CLIENT_SECRET=__PROD_B24_CLIENT_SECRET__
# Опционально: env-fallback проверки /webhook/b24, пока в БД нет токена из install-callback'а.
B24_APPLICATION_TOKEN=
# Числовой ID Открытой линии.
OL_LINE_ID=__PROD_OL_LINE_ID__
B24_CONNECTOR_ID=max_b24
B24_CONNECTOR_NAME=Макс для групп
# Боевой обработчик событий Б24 (OnImConnector*, OnAppUninstall; Caddy → api-node). register-events.js.
B24_EVENT_HANDLER_URL=https://__PROD_DOMAIN__/webhook/b24
# Боевой URL заглушки настроек коннектора (Caddy → api-node).
B24_PLACEMENT_HANDLER_URL=https://__PROD_DOMAIN__/b24/connector-settings

## --- Медиа (опционально — есть дефолты) --------------------------------------
# Передача файлов MAX <-> OL. Опциональны (валидация на старте). См. docs/backend/env.md.
# MAX_UPLOAD_MAX_RETRIES=14
# MAX_UPLOAD_RETRY_BASE_MS=1000
# MAX_UPLOAD_RETRY_FACTOR=2
# MEDIA_MAX_BYTES=268435456
# MEDIA_TRANSFER_TIMEOUT_MS=300000
# MEDIA_CONCURRENCY=2
# MEDIA_TMP_DIR=/tmp/maxtob24-media

## --- Очередь исходящих и остановка (опционально — есть дефолты) --------------
# Исходящие OL → MAX одного чата идут по очереди; сверх лимита — без ожидания (WARN).
# Дренаж по SIGTERM держать меньше stop_grace_period api-node (180s в
# docker-compose.server.yml) не меньше чем на 10 с: дедлайн + 5 с на закрытие порта и пула
# (жёсткий таймер процесса) + запас до SIGKILL. См. docs/backend/outbound-queue.md.
# OUTBOUND_QUEUE_MAX=20
# SHUTDOWN_DRAIN_TIMEOUT_MS=170000

## --- База данных (Postgres, только внутри internal-net) -----------------------
DB_NAME=appdb
DB_USER=appuser
DB_PASSWORD=__PROD_DB_PASSWORD__
# Хост = alias `database` в internal-net. Порт НАРУЖУ не публикуется (см. docker-compose.server.yml).
DATABASE_URL=postgresql://appuser:__PROD_DB_PASSWORD__@database:5432/appdb
