# Шаблон для разработки: cp .env.example .env и заполнить пустые значения.
# Полная таблица переменных — docs/backend/env.md, прод-шаблон — .env.prod.example.

## Database (Postgres)
DB_NAME=appdb
DB_USER=appuser
DB_PASSWORD=apppass
DB_PORT=5432
# Хост `database` — имя сервиса в compose-сети. Процесс на хосте (pnpm db:migrate, скрипты
# из backends/node/api) читает этот .env сам, но `database` оттуда не резолвится: задайте
# DATABASE_URL с localhost:<DB_PORT> в env процесса — файл его не перебьёт (docs/backend/env.md).
DATABASE_URL=postgresql://appuser:apppass@database:5432/appdb

# BUILD_TARGET dev | production
BUILD_TARGET=dev

## Процесс
NODE_ENV='development'
API_PORT=8000
# для api-node при локальном запуске вне docker. В docker-compose
# переопределяется через environment.PORT (см. docs/backend/env.md).
LOG_LEVEL=debug

## MAX Bot API
MAX_BOT_TOKEN=
MAX_WEBHOOK_SECRET=
# Канонический хост MAX API; сертификат выдан Russian Trusted Sub CA (Минцифры) — в образе
# корень подключён через NODE_EXTRA_CA_CERTS (Dockerfile). Вне Docker без CA — https://botapi.max.ru.
MAX_API_BASE_URL=https://platform-api2.max.ru

## MAX Bot API webhook
# Публичный HTTPS-URL до /webhook/max — обычно https://<your-domain>/webhook/max
# (прод: Caddy проксирует /webhook/* напрямую в api-node:8000).
# Передаётся в POST /subscriptions из scripts/register-webhook.js.
MAX_PUBLIC_WEBHOOK_URL=
# Опциональный override — обычно не нужен (default уже включает все нужные типы).
# Если задаёте явно — перечислите все: без message_edited/message_removed не дойдут правка и удаление
# MAX→OL, без chat_title_changed — переименование группы в чат ОЛ.
# MAX_WEBHOOK_UPDATE_TYPES=message_created,message_edited,message_removed,bot_added,bot_removed,user_added,user_removed,chat_title_changed

## Bitrix24
# B24_PORTAL — домен портала (например, your.bitrix24.ru). POST /api/install принимает
# только события этого портала и пишет токены в его строку installations.
# B24_CLIENT_ID / B24_CLIENT_SECRET — ключи локального приложения (Б24 показывает их после
# сохранения формы). ОБЯЗАТЕЛЬНЫ: install-callback проверяет подлинность обменом
# refresh_token с этими ключами (без них /api/install → 503), ими же продлевается
# access_token. Первая установка: сохранить форму → вписать ключи → пересоздать
# контейнер → пересохранить форму (docs/backend/app-installation.md).
B24_PORTAL=
B24_CLIENT_ID=
B24_CLIENT_SECRET=
# Опционально: env-fallback проверки /webhook/b24, пока в БД нет токена из install-callback'а.
# После удаления приложения (ONAPPUNINSTALL) не действует — нужна переустановка.
B24_APPLICATION_TOKEN=
# Числовой ID Открытой линии, к которой подключается коннектор (README, «Быстрый старт»).
OL_LINE_ID=
## Б24 — регистрация коннектора
B24_CONNECTOR_ID=max_b24
B24_CONNECTOR_NAME=Макс для групп
# Публичный HTTPS-URL заглушки настроек коннектора (на dev — HTTPS-туннель к backend'у):
#   https://<your-domain>/b24/connector-settings
B24_PLACEMENT_HANDLER_URL=
# Публичный HTTPS-URL обработчика событий Б24 — OnImConnectorMessageAdd/Update/Delete,
# OnImConnectorDialogFinish, OnAppUninstall (на dev — HTTPS-туннель):
#   https://<your-domain>/webhook/b24
# Передаётся в event.bind из scripts/register-events.js (make register-events).
B24_EVENT_HANDLER_URL=

## Медиа (optional — defaults applied if unset)
# Передача файлов MAX <-> OL в обе стороны. Все переменные опциональны
# (валидация значений на старте). RETRY на шаге POST /messages — только пока MAX
# обрабатывает вложение (HTTP 400 attachment.not.ready) и на 429. Перезаливки нет.
# MAX_UPLOAD_MAX_RETRIES=14
# MAX_UPLOAD_RETRY_BASE_MS=1000
# MAX_UPLOAD_RETRY_FACTOR=2
# Лимит размера файла OL → MAX в байтах (256 МиБ). Больше → файл не уходит,
# оператору — системное сообщение в ОЛ.
# MEDIA_MAX_BYTES=268435456
# Дедлайн скачивания из Б24 и заливки в MAX (каждой отдельно), мс.
# MEDIA_TRANSFER_TIMEOUT_MS=300000
# Сколько файлов передаётся одновременно; файлы идут через временный каталог.
# MEDIA_CONCURRENCY=2
# MEDIA_TMP_DIR=/tmp/maxtob24-media

## Очередь исходящих и остановка (optional — defaults applied if unset)
# Исходящие OL → MAX одного чата идут по очереди. Лимит очереди чата: сверх него
# задание выполняется сразу, без ожидания и вне порядка (WARN). Default: 20, clamp ≤ 1000.
# OUTBOUND_QUEUE_MAX=20
# Сколько ждать опустошения очереди по SIGTERM (порт открыт), мс. Меньше
# stop_grace_period контейнера (180s) не меньше чем на 10 с: жёсткий таймер процесса —
# дедлайн + 5 с на закрытие порта и пула, плюс запас до SIGKILL Docker. Default: 170000.
# SHUTDOWN_DRAIN_TIMEOUT_MS=170000

## Reply/цитирование (двусторонний мост «ответ на сообщение», optional — defaults applied if unset)
# MAX→OL: участник ответил → оператор видит визуальную [quote]-цитату в тексте OL
#   (без БД и без REST, всегда включено).
# OL→MAX: оператор сделал reply → участники видят нативный кликабельный reply в MAX.
#   Требует ДОБОРА REPLY_ID методом im.dialog.messages.search — это +1 REST-запрос
#   на КАЖДОЕ исходящее сообщение. Отключаемо флагом ниже (best-effort: при сбое
#   сообщение уходит без reply).
# Включить добор нативного reply OL→MAX (true/false, 1/0). Default: true.
# B24_REPLY_RESOLVE_OUTBOUND=true
# Размер окна листинга im.dialog.messages.search (LIMIT). Default: 50, clamp ≤ 200.
# REPLY_SEARCH_LIMIT=50
# Макс. длина текста родителя в [quote]-цитате MAX→OL (символы). Default: 200.
# REPLY_QUOTE_MAX_LEN=200

## Rate limiting публичных роутов (optional — defaults applied if unset)
# install — строгий ОБЩИЙ потолок (каждый запрос может уйти обменом refresh_token на OAuth);
# webhook — щадящие per-IP бакеты, свои у /webhook/max и /webhook/b24.
# Реальный IP: TRUST_PROXY — кому верить X-Forwarded-For (CSV loopback|linklocal|uniquelocal|IP|CIDR,
# false или число хопов; true/* запрещены). Дефолт подходит под Caddy → docker-proxy (шлюз в 172.16/12).
# TRUST_PROXY=loopback, uniquelocal
# RATE_LIMIT_INSTALL_WINDOW_MS=900000   # 15 минут
# RATE_LIMIT_INSTALL_MAX=30
# RATE_LIMIT_WEBHOOK_WINDOW_MS=60000     # 1 минута
# RATE_LIMIT_WEBHOOK_MAX=600
